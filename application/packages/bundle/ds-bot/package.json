{
  "name": "@deepseek-ai/dsh-bot",
  "version": "0.2.1-alpha.3",
  "description": "DS Bot: a team of long-lived Bots for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/Fei2411/DeepSeek-Bot#readme",
  "bugs": {
    "url": "https://github.com/Fei2411/DeepSeek-Bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/ds-bot"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./web-search": "./lib/web-search.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/web-search.js",
    "lib/src/**/*.js",
    "lib/types/**/*.d.ts"
  ],  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-lib.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-web": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "esbuild": "0.28.2"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
