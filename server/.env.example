# Hub 端配置模板。请复制为 .env 并输入真实值，绝不可提交生产秘钥。
NODE_ENV=production
HUB_HOST=127.0.0.1
HUB_PORT=8443
HUB_DATA_DIR=/var/lib/workgroup-ai
HUB_PUBLIC_URL=https://hub.intranet.example
# HUB_TLS_CERT=/etc/workgroup-ai/tls/server.pem
# HUB_TLS_KEY=/etc/workgroup-ai/tls/server-key.pem
# HUB_TOKEN_SIGNING_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
# HUB_ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_ONE_TIME_SECRET
HUB_MAX_MESSAGE_BYTES=131072
HUB_MAX_UPLOAD_BYTES=10485760
HUB_LOG_LEVEL=info

# Retention. The audit trail is the record of the decisions the Hub enforced, so it is kept
# forever unless a window is configured here. Run `hub audit-prune --dry-run` before the first
# real prune: a window that turns out to be too short cannot be undone.
# HUB_AUDIT_RETENTION_DAYS=730
# HUB_BACKUP_RETENTION_COUNT=30
