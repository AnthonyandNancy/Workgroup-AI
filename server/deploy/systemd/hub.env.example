# /etc/workgroup-ai/hub.env — install with mode 0600, owned by the service user.
# Copy server/.env.example and fill in real values; this file is the one place the Hub's
# configuration lives, so the unit file itself can stay in version control.
NODE_ENV=production
HUB_HOST=127.0.0.1
HUB_PORT=8443
HUB_DATA_DIR=/var/lib/workgroup-ai
HUB_PUBLIC_URL=https://hub.intranet.example
HUB_TLS_CERT=/etc/workgroup-ai/tls/server.pem
HUB_TLS_KEY=/etc/workgroup-ai/tls/server-key.pem
# Generate with: openssl rand -base64 48
HUB_TOKEN_SIGNING_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
HUB_ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_ONE_TIME_SECRET
HUB_AUDIT_RETENTION_DAYS=730
HUB_BACKUP_RETENTION_COUNT=30
