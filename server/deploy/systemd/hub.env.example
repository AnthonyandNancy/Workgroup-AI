# /etc/workgroup-ai/hub.env — install with mode 0600, owned by the service user.
# Copy server/.env.example and fill in real values; this file is the one place the Hub's
# configuration lives, so the unit file itself can stay in version control.
NODE_ENV=production
HUB_HOST=127.0.0.1
HUB_PORT=8443
HUB_DATA_DIR=/var/lib/workgroup-ai
HUB_PUBLIC_URL=https://hub.intranet.example
HUB_TLS_CERT=/etc/workgroup-ai/tls/server.pem
HUB_TLS_KEY=/etc/workgroup-ai/tls/server-key.pem
# Generate with: openssl rand -base64 48
HUB_TOKEN_SIGNING_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
HUB_ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_ONE_TIME_SECRET
HUB_AUDIT_RETENTION_DAYS=730
HUB_BACKUP_RETENTION_COUNT=30
# Throttling for failed registration and sign-in. Counters live in the database, so a restart no
# longer clears an earned lockout.
HUB_LOGIN_MAX_ATTEMPTS=10
HUB_LOGIN_WINDOW_SECONDS=300
HUB_LOGIN_LOCKOUT_SECONDS=300
# Anonymous workgroup bootstrap. Keep false on a company Hub; a demo deployment sets it to true so
# DS Bot can create a guest identity without a password. The two limits bound failed attempts per
# source within the window. Denying the endpoint leaves local Bots and chats unaffected.
HUB_ANONYMOUS_BOOTSTRAP=false
HUB_BOOTSTRAP_MAX_ATTEMPTS=5
HUB_BOOTSTRAP_WINDOW_SECONDS=300
# Only set this when a reverse proxy terminates TLS in front of the Hub. Listing the proxy is what
# makes the forwarded client address trustworthy; without it, per-source throttling keys on the
# proxy and shares one budget across everyone.
# HUB_TRUSTED_PROXIES=10.0.0.0/8
# Group memory ceiling per room. `0` keeps every entry; a positive value evicts oldest-first and
# softly: the entry stops being readable while its revision trail and audit row survive.
HUB_MAX_MEMORIES_PER_ROOM=0
